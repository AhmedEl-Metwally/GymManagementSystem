@model IEnumerable<MemberForSessionViewModel>

@{
    ViewData["Title"] = "GetMemberForUpcomingSession";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1 fw-semibold">Session Members</h2>
            <p class="mb-0 text-light opacity-75">Members That Already Member Session</p>
        </div>
        <div class="text-end">
            <a asp-action="Create" asp-route-id="@ViewBag.SessionId" class="btn btn-light">
                <i class="fas fa-plus me-1"></i> New Member Session
            </a>
        </div>
    </div>
</header>
<div class="card shadow-sm">
    <div class="card-body">
        @if (Model is not null && Model.Any())
        {
            <table class="table table-striped table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>@nameof(MemberForSessionViewModel.MemberName)</th>
                        <th>@nameof(MemberForSessionViewModel.BookingDate)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                    <tr>
                        <td>@member.MemberName</td>
                        <td>@member.BookingDate</td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                    <form method="post" asp-action="MemberCancel" class="m-0">
                                        <input type="hidden" value="@member.MemberId" name="MemberId" />
                                        <input type="hidden" value="@member.SessionId" name="SessionId" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to cancel this Member Session?');">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-person-workspace display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No Member Session Available</h4>
                <p class="text-muted">Add your first Member Session to get started</p>
            </div>
        }
    </div>

    <a asp-action="Index" class="btn btn-fill ">Back to List</a>

</div>



@section Scripts
{
    <script src="~\js\alert.js" asp-append-version="true"></script>
}