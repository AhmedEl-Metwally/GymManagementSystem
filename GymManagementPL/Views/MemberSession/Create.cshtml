@model CreateMemberSessionViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create New Member Session</h1>

<hr />
<div class="row">
    <div class="d-flex justify-content-center align-items-center h-100">

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Member Session Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <input type="hidden" asp-for="SessionId" value="@ViewBag.SessionId" readonly />
                            <label asp-for="MemberId" class="form-label">Member</label>
                            <select asp-for="MemberId" asp-items="ViewBag.Members" name="memberId" class="form-select">
                                <option value="">-- Select Member --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create Member Session
                            </button>
                            <a asp-action="GetMemberForUpcomingSession" asp-method="post"  class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/member-select.js" asp-append-version="true"></script>
}

